# Node Manager Agent - Lightweight connectivity monitoring agent
# This minimal image runs as a DaemonSet on each node to monitor connectivity

FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install only essential packages (alpine uses iputils for ping)
RUN apk add --no-cache \
    iputils \
    libcap \
    && setcap cap_net_raw+ep /bin/ping

WORKDIR /app

# Install only aiohttp (the only dependency for the agent)
RUN pip install --no-cache-dir aiohttp

# Copy only the agent code
COPY src/kitchen/node_manager/agent.py /app/agent.py

# Create non-root user
RUN addgroup -g 1000 agent && \
    adduser -u 1000 -G agent -D agent

USER agent

# No port exposed - agent only makes outbound connections

HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "python /app/agent.py" || exit 1

CMD ["python", "/app/agent.py"]
