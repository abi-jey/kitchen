# Kitchen Node Manager Environment Configuration

# Database connection URL
database_url='postgresql+asyncpg://user:password@localhost:5432/kitchen_node_manager'

# Debug mode: set to 'true' to enable debug logging
debug='false'

# Log level: DEBUG, INFO, WARNING, ERROR (ignored if debug=true)
log_level='INFO'

# Server configuration
host='0.0.0.0'
port='8000'

# Monitoring intervals (seconds)
monitoring_interval='60'
connectivity_interval='300'

# Ping configuration
ping_count='4'
ping_timeout='5'

# Server-side connectivity checks (set to 'false' when using DaemonSet agents)
# When false, only agents report connectivity; server only monitors K8s node status
enable_server_connectivity='false'
