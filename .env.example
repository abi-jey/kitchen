# Kitchen Node Manager Environment Configuration

# Database connection URL
DATABASE_URL='postgresql+asyncpg://user:password@localhost:5432/kitchen_node_manager'

# Debug mode: set to 'true' to enable debug logging
DEBUG='false'

# Log level: DEBUG, INFO, WARNING, ERROR (ignored if DEBUG=true)
LOG_LEVEL='INFO'

# Server configuration
HOST='0.0.0.0'
PORT='8000'

# Monitoring interval (seconds) - how often to check K8s node status
MONITORING_INTERVAL='60'
